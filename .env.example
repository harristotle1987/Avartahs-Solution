# ==============================================================================
# AVARTAH SOLUTIONS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# - Server-only secrets MUST NEVER be prefixed with VITE_
# - In production (Vercel), configure these in your deployment dashboard / secrets manager
# - Do NOT commit populated .env files to source control or public repositories
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE INFRASTRUCTURE (Server-Only, Required)
# ------------------------------------------------------------------------------
# Connection string for Neon Serverless PostgreSQL with SSL enabled.
# In Vercel Production, use Neon's POOLED endpoint hostname (contains `-pooler`)
# with `?sslmode=require` so serverless functions avoid connection timeouts.
# Format: postgresql://[user]:[password]@[ep-xxx-pooler.region.aws.neon.tech]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Server-Only, Required)
# ------------------------------------------------------------------------------
# Cryptographically random secret used for HMAC-SHA256 session token signatures
# and double-submit CSRF tokens across all Vercel server/serverless handlers.
# MUST be at least 32 characters (recommended 64 hex chars / 256-bit entropy).
# Production auth fails closed (HTTP 503) if missing, weak, or placeholder.
# NEVER prefix with VITE_ or commit real values to Git.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_minimum_32_characters_random_hex_secret_here

# Base URL of the deployed application used for CSRF origin matching, password reset links, and Paystack return URLs.
APP_BASE_URL=https://avartahs-solution.vercel.app

# Comma-separated list of trusted origins allowed to make cross-origin credentialed requests.
# In production, this must match your exact verified domain(s) without wildcards.
ALLOWED_ORIGINS=https://avartahs-solution.vercel.app,https://avartah.com,https://www.avartah.com

# ------------------------------------------------------------------------------
# 3. PAYSTACK PAYMENT & SUBSCRIPTION BILLING (Server-Only & Client-Safe)
# ------------------------------------------------------------------------------
# Operational mode: 'test' for staging/sandbox development or 'live' for production transactions
PAYSTACK_MODE=test

# Primary billing currency (Strictly NGN for Nigerian business billing)
PAYMENT_CURRENCY=NGN

# Paystack Secret Key (Server-Only, Required for verified subscriptions)
# Used for server-to-server transaction verification (GET /transaction/verify/:ref)
# and HMAC-SHA512 webhook signature verification. Starts with sk_test_ or sk_live_
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_actual_paystack_secret_key

# Public Key for frontend Paystack popup checkout (Client-Safe, starts with pk_test_ or pk_live_)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_actual_paystack_public_key

# Authoritative server-side callback URL for hosted Paystack checkout returns.
# Paystack redirects the customer browser here with ?trxref=...&reference=...
# Server verifies transaction via Paystack API before redirecting to /business-os/billing.
# Keep separate from the webhook endpoint (/api/os/payments/paystack/webhook).
PAYSTACK_CALLBACK_URL=https://avartah.com/api/os/payments/paystack/callback

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL & PASSWORD RECOVERY (Server-Only, Optional)
# ------------------------------------------------------------------------------
# Resend API key for automated password reset notifications and invoice emails
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Sender email address for outgoing system communications
EMAIL_FROM=Avartah Solutions <support@avartah.com>

# ------------------------------------------------------------------------------
# 5. AI ENGINE & INTELLIGENT LEAD PROSPECTING (Server-Only, Optional)
# ------------------------------------------------------------------------------
# Primary AI Model Provider (NVIDIA NIM - e.g. meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional Secondary AI Fallback (Google Gemini - only used if NVIDIA_API_KEY is unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Permitted enrichment and geocoding providers (Optional)
LOCATIONIQ_API_KEY=your_locationiq_api_key_here
APILAYER_API_KEY=your_apilayer_api_key_here
POSITIONSTACK_API_KEY=your_positionstack_api_key_here
SCRAPESTACK_API_KEY=your_scrapestack_api_key_here
MAILBOXLAYER_API_KEY=your_mailboxlayer_api_key_here
